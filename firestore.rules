rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // One shared garage per link. The room id in the link is the only key: rooms cannot be listed.
    match /rooms/{room}/cars/{car} {
      allow read, delete: if room.size() >= 10;
      allow create: if room.size() >= 10
        && request.resource.data.keys().hasOnly(['name', 'src', 'stats', 'at'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 16
        && request.resource.data.src is string && request.resource.data.src.size() < 300000
        && request.resource.data.src.matches('^data:image/(png|webp);base64,[A-Za-z0-9+/=]+$')
        && request.resource.data.stats is map && request.resource.data.at is number;
    }
    match /rooms/{room}/race/{doc} {
      allow read: if room.size() >= 10;
      allow write: if room.size() >= 10 && doc == 'current'
        && request.resource.data.keys().hasOnly(['id', 'seed', 'at', 'grid'])
        && request.resource.data.id is string && request.resource.data.id.size() <= 40
        && request.resource.data.grid is list && request.resource.data.grid.size() <= 9;
    }
  }
}
